# Anthropic API key — required for the agent loop in api/.
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXX-replace-with-your-key

# Shared secret used by Cube to sign and verify scoped JWTs.
# Use any long random string in local dev; rotate for production.
CUBE_API_SECRET=dev-only-secret-change-me

# Sample-only: which team the demo manager can see. The mock auth in api/auth.py
# defaults to this. In production this comes from real SSO, never an env var.
DEMO_MANAGER_SCOPE=Engineering

# Postgres connection used by the API for audit logging and training CRUD.
# api_writer role: INSERT audit_log + full training table access.
AUDIT_DB_URL=postgresql://api_writer:api@localhost:5432/hr

# Optional override for training DB (defaults to AUDIT_DB_URL).
# TRAINING_DB_URL=postgresql://api_writer:api@localhost:5432/hr

# OpenAI API key — required for policy document embeddings (text-embedding-3-small).
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXX-replace-with-your-key

# Optional: directory for uploaded policy PDFs (defaults to data/policy_uploads/).
# POLICY_UPLOAD_DIR=./data/policy_uploads

# Optional: receipt image storage (defaults to data/expense_receipts/).
# EXPENSE_UPLOAD_DIR=./data/expense_receipts

# Optional override for policies DB (defaults to AUDIT_DB_URL).
# POLICIES_DB_URL=postgresql://api_writer:api@localhost:5432/hr

# Legacy / unused by training — kept for reference.
DATABASE_URL=postgresql://hr:hr@localhost:5432/hr
